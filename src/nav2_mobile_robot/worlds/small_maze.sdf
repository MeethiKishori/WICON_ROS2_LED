<?xml version="1.0"?>
<sdf version='1.8'>
    <world name='small_maze'>
        <physics name='1ms' type='ignored'>
            <max_step_size>0.003</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
        </physics>
        <plugin name='ignition::gazebo::systems::Physics' filename='ignition-gazebo-physics-system' />
        <plugin name='ignition::gazebo::systems::UserCommands' filename='ignition-gazebo-user-commands-system' />
        <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system' />
        <plugin name='ignition::gazebo::systems::Contact' filename='ignition-gazebo-contact-system' />

        <light name='sun' type='directional'>
            <cast_shadows>1</cast_shadows>
            <pose>0 0 10 0 -0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.7 0.7 1</background>
            <shadows>1</shadows>
        </scene>

        <!-- Ground -->
        <model name='ground_plane'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
                </collision>
                <visual name='visual'>
                    <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
                    <material>
                        <ambient>1 0.714 0.757 1</ambient>
                        <diffuse>1 0.714 0.757 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 2x2m outer boundary: walls at x=+-1, y=+-1 -->

        <model name='wall_west'>
            <static>1</static>
            <pose>-1 0 0.5 0 0 0</pose>
            <link name='link'>
                <collision name='collision'>
                    <geometry><box><size>0.05 2.05 1</size></box></geometry>
                </collision>
                <visual name='visual'>
                    <geometry><box><size>0.05 2.05 1</size></box></geometry>
                    <material>
                        <ambient>0.15 0.3 0.85 1</ambient>
                        <diffuse>0.2 0.4 0.95 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name='wall_east'>
            <static>1</static>
            <pose>1 0 0.5 0 0 0</pose>
            <link name='link'>
                <collision name='collision'>
                    <geometry><box><size>0.05 2.05 1</size></box></geometry>
                </collision>
                <visual name='visual'>
                    <geometry><box><size>0.05 2.05 1</size></box></geometry>
                    <material>
                        <ambient>0.15 0.3 0.85 1</ambient>
                        <diffuse>0.2 0.4 0.95 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name='wall_north'>
            <static>1</static>
            <pose>0 1 0.5 0 0 0</pose>
            <link name='link'>
                <collision name='collision'>
                    <geometry><box><size>2.05 0.05 1</size></box></geometry>
                </collision>
                <visual name='visual'>
                    <geometry><box><size>2.05 0.05 1</size></box></geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.55 0.55 0.55 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name='wall_south'>
            <static>1</static>
            <pose>0 -1 0.5 0 0 0</pose>
            <link name='link'>
                <collision name='collision'>
                    <geometry><box><size>2.05 0.05 1</size></box></geometry>
                </collision>
                <visual name='visual'>
                    <geometry><box><size>2.05 0.05 1</size></box></geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.55 0.55 0.55 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Interior dividers. Taller than the lidar (0.3m) so they occlude.
             Each leaves a gap at one end, forming an S-shaped corridor:
             the robot at (0,0) cannot see the far side of either divider. -->

        <!-- Divider A: x=-0.35, spans y=-1.0 .. 0.3 (gap at north end) -->
        <model name='divider_a'>
            <static>1</static>
            <pose>-0.35 -0.35 0.25 0 0 0</pose>
            <link name='link'>
                <collision name='collision'>
                    <geometry><box><size>0.05 1.3 0.5</size></box></geometry>
                </collision>
                <visual name='visual'>
                    <geometry><box><size>0.05 1.3 0.5</size></box></geometry>
                    <material>
                        <ambient>0.2 0.2 0.2 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Divider B: x=0.35, spans y=-0.3 .. 1.0 (gap at south end) -->
        <model name='divider_b'>
            <static>1</static>
            <pose>0.35 0.35 0.25 0 0 0</pose>
            <link name='link'>
                <collision name='collision'>
                    <geometry><box><size>0.05 1.3 0.5</size></box></geometry>
                </collision>
                <visual name='visual'>
                    <geometry><box><size>0.05 1.3 0.5</size></box></geometry>
                    <material>
                        <ambient>0.2 0.2 0.2 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
    </world>
</sdf>
