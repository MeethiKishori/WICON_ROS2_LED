<?xml version="1.0"?>

<robot name="nav_robot"
  xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="odom_plugin.xacro" />

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

      <left_joint>${prefix}left_wheel_joint</left_joint>
      <right_joint>${prefix}right_wheel_joint</right_joint>
      <wheel_separation>${2*base_radius}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <frame_id>${prefix}odom</frame_id>
      <child_frame_id>${prefix}base_link</child_frame_id>

      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>

      <topic>${ns}/cmd_vel</topic>
      <robotBaseFrame>${prefix}base_link</robotBaseFrame>

    </plugin>
  </gazebo>

  <gazebo reference="${prefix}passive_wheel_front_link">
    <mu1 value="0.1" />
    <mu2 value="0.1" />
  </gazebo>

  <gazebo reference="${prefix}passive_wheel_back_link">
    <mu1 value="0.1" />
    <mu2 value="0.1" />
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>${ns}/joint_states</topic>
      <joint_name>${prefix}left_wheel_joint</joint_name>
      <joint_name>${prefix}right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
