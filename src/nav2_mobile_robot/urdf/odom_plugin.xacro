<?xml version="1.0"?>

<robot name="nav_robot"
  xmlns:xacro="http://ros.org/wiki/xacro">

  <gazebo>
    <plugin filename='gz-sim-odometry-publisher-system' name='gz::sim::systems::OdometryPublisher' >
      <dimensions>3</dimensions>
      <!-- 20, not 50. controller_frequency is 20 Hz, so 50 buys nothing,
           and every odom message wakes the rclpy executors in
           fleet_manager and peer_obstacles, which re-walk their whole
           wait set on each wakeup. At 50 Hz those two nodes burned about
           1.4 cores between them, starving Nav2's controllers until they
           reported 'Failed to make progress' and the robots stalled. -->
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_topic>${ns}/odom</odom_topic>
      <odom_frame>${prefix}odom</odom_frame>
      <robot_base_frame>${prefix}base_link</robot_base_frame>
      <tf_topic>${ns}/odom/tf</tf_topic>
    </plugin>
  </gazebo>

</robot>
