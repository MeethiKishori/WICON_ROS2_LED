<?xml version="1.0"?>

<robot name="nav_robot"
  xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="PI" value="3.14159"/>

  <!-- 3600 samples (0.1 deg) is what a single robot uses so adjacent rays stay
       inside one 0.003125 m map cell out to ~1.8 m. With N robots the GPU lidar
       cost multiplies, so the multi-robot launch lowers this. -->
  <xacro:arg name="lidar_samples" default="3600" />

  <link name="${prefix}lidar_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name='${prefix}lidar_sensor_joint' type='fixed'>
    <parent link="${prefix}base_link"/>
    <child link="${prefix}lidar_link"/>
  </joint>

  <gazebo reference="${prefix}lidar_link">
    <sensor name="lidar" type='gpu_lidar'>
      <pose>0 0 0.2 0 0 0</pose>
      <topic>${ns}/lidar</topic>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>$(arg lidar_samples)</samples>
            <resolution>1</resolution>
            <min_angle>-3.141593</min_angle>
            <max_angle>3.141593</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <gz_frame_id>${prefix}lidar_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
